{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci && npm run build && cd .. && mkdir -p public && cp -R frontend/dist/. public/",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "backend/**,data/**,frontend/dist/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/holdings", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/changes", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/map", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/research", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/stock/:symbol", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__path=:path*"
    }
  ]
}
