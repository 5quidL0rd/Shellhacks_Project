# Settings for the backend. The backend reads backend/.env first, then the
# project-root .env, so you can keep everything in the root .env instead.
# Never commit either .env file, programmatic tokens, or private keys.

# --- Story Mode ---
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Recommended: gemini-3.8-flash (quality) or gemini-3.5-flash-lite (cheap/fast)
GEMINI_MODEL=gemini-3.8-flash

# Free tier: 60 calls/min. https://finnhub.io/register
FINNHUB_API_KEY=

# SEC EDGAR needs no key, but DOES require a real contact email or it returns 403.
SEC_USER_AGENT=ShellhacksPortfolioStory your-email@example.com

# --- Snowflake ---
# AWS US East accounts use "<locator>.us-east-1" with no ".aws" suffix;
# adding ".aws" fails with an SSL certificate error.
SNOWFLAKE_ACCOUNT=RAC74299.us-east-1
SNOWFLAKE_USER=SHELLHACKS_APP
SNOWFLAKE_ROLE=SHELLHACKS_APP_ROLE
SNOWFLAKE_WAREHOUSE=SHELLHACKS_WH
SNOWFLAKE_DATABASE=SHELLHACKS_DB
SNOWFLAKE_SCHEMA=STORY_MODE

# Choose exactly one authentication method.
# Option A (recommended): key-pair authentication. The key stays outside Git.
# A relative path is resolved from the project root.
SNOWFLAKE_AUTH_MODE=keypair
SNOWFLAKE_PRIVATE_KEY_FILE=backend/keys/shellhacks_app_key.p8
# Only if the key was created with a passphrase:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Option B: Snowflake programmatic-access token (PAT).
# SNOWFLAKE_AUTH_MODE=pat
# SNOWFLAKE_PROGRAMMATIC_ACCESS_TOKEN=
