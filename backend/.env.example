# Copy this file to backend/.env and replace every value locally.
# Never commit backend/.env or post these values in chat.
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-snowflake-user
SNOWFLAKE_PASSWORD=your-snowflake-password
SNOWFLAKE_WAREHOUSE=SHELLHACKS_WH
SNOWFLAKE_DATABASE=SHELLHACKS_DB
SNOWFLAKE_SCHEMA=STORY_MODE
