# Copy this file to backend/.env and replace every value locally.
# Never commit backend/.env, programmatic tokens, or private keys.
SNOWFLAKE_ACCOUNT=RAC74299.us-east-1.aws
SNOWFLAKE_USER=SHELLHACKS_APP
SNOWFLAKE_ROLE=SHELLHACKS_APP_ROLE
SNOWFLAKE_WAREHOUSE=SHELLHACKS_WH
SNOWFLAKE_DATABASE=SHELLHACKS_DB
SNOWFLAKE_SCHEMA=STORY_MODE

# Choose exactly one authentication method.
# Option A (recommended): key-pair authentication. The key stays outside Git.
SNOWFLAKE_AUTH_MODE=keypair
SNOWFLAKE_PRIVATE_KEY_FILE=backend/keys/shellhacks_app_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=replace-locally

# Option B: Snowflake programmatic-access token (PAT).
# SNOWFLAKE_AUTH_MODE=pat
# SNOWFLAKE_PROGRAMMATIC_ACCESS_TOKEN=replace-locally
